{
  "run_dir": "runs/ai_factory_all_v4/shard_174",
  "seeds": {
    "dir": "runs/ai_factory_all_v4/shard_174/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v4/shard_174/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v4/shard_174/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_doc-slaif-si_3be3f8110d355ed2",
      "fac_docs-archer2-ac-uk_3a1f9ae61c656707",
      "fac_docs-archer2-ac-uk_43472138e8e79f64",
      "fac_docs-csc-fi_b2458a56f4e27cb4",
      "fac_docs-cscs-ch_1a6c49274805c011",
      "fac_docs-discoverer-bg_c7dd0c322278afd2",
      "fac_docs-vsc-ac-at_221adcaadf222cfc",
      "fac_github-com_18233bff7d183e5d",
      "fac_github-com_1b411c1154ccacb3",
      "fac_github-com_1e56d4cdc0714640",
      "fac_github-com_7c96a441022fa545",
      "fac_github-com_86ac77e2784d81de",
      "fac_lumi-supercomputer-github-io_5934f00a97a8870b",
      "fac_www-idris-fr_1ceb2a9c75ff4b34"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v4/shard_174/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
