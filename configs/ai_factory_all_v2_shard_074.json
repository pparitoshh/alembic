{
  "run_dir": "runs/ai_factory_all_v2/shard_074",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_074/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_074/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_074/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_doc-slaif-si_bb50ff01819e79cd",
      "fac_doc-slaif-si_eb14e2db06714833",
      "fac_docs-archer2-ac-uk_3a1f9ae61c656707",
      "fac_docs-discoverer-bg_2a7a7b1335f3c15e",
      "fac_docs-hpc-gwdg-de_a4bcf81256f54b7f",
      "fac_doku-lrz-de_353efe38bb0fdc22",
      "fac_doku-lrz-de_b78d7acca6e993bf",
      "fac_github-com_445628d8f51bf782",
      "fac_github-com_4b3c956b2b6134eb",
      "fac_github-com_57498fd07731b0a7",
      "fac_github-com_6353c4196b5f6e59",
      "fac_github-com_a2d90a8cede43c41",
      "fac_github-com_c6b691c2066d8f61",
      "fac_hpcf-cyi-ac-cy_620e8be8282a5e90",
      "fac_lumi-supercomputer-github-io_4393bf137402101a",
      "fac_lumi-supercomputer-github-io_942f3b36a7582725",
      "fac_raw-githubusercontent-com_fb674125a0ad1609",
      "fac_userdocs-hpc-sav-sk_e7015835b77604a2",
      "fac_www-hpc-cea-fr_478ad9caf87254f9",
      "fac_www-idris-fr_34116b913b4a67f6",
      "fac_www-nsc-liu-se_d6cb571b5efc437b"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_074/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
