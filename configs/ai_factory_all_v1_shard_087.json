{
  "run_dir": "runs/ai_factory_all_v1/shard_087",
  "seeds": {
    "dir": "runs/ai_factory_all_v1/shard_087/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v1/shard_087/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v1/shard_087/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_dci-dci-gitlab-cines-fr_15dfa97362a17b5e",
      "fac_docs-cscs-ch_51bf22236ef085e7",
      "fac_docs-hpc-gwdg-de_39c69af55d4ec15a",
      "fac_docs-lumi-supercomputer-eu_3b4775949db6375f",
      "fac_docs-vscentrum-be_ad82ae40db1ec364",
      "fac_github-com_1b1996be88e8537f",
      "fac_github-com_25ee607ac5cffa9f",
      "fac_github-com_4cddc432059acf1e",
      "fac_github-com_a26636f8a2ae570d",
      "fac_github-com_c75091666c89f9ab",
      "fac_github-com_dd5409414d279cda",
      "fac_github-com_e2477bcf1d7be116",
      "fac_github-com_f346b9e252282d83",
      "fac_userdocs-hpc-sav-sk_09c5355ac1cb8c93",
      "fac_wiki-irei-is_f2003f95ad568108",
      "fac_www-idris-fr_b834a226c3c88f2c"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v1/shard_087/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
