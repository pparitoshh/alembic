{
  "run_dir": "runs/ai_factory_all_v2/shard_025",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_025/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_025/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_025/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_cesga-docs-gitlab-io_d8028c2bb3fcf8da",
      "fac_doc-slaif-si_b6aacf0c3f34e344",
      "fac_docs-csc-fi_d8ed18fa54277582",
      "fac_docs-csc-fi_e6caed6b8b86ae43",
      "fac_docs-hpc-gwdg-de_39c69af55d4ec15a",
      "fac_docs-hpc-gwdg-de_ca2423363f9bbfe9",
      "fac_docs-lxp-lu_81169db6f870ce67",
      "fac_docs-lxp-lu_f928b25a5a518fae",
      "fac_doku-lrz-de_64fcf8a0d5f57066",
      "fac_github-com_14f1784cc7b11789",
      "fac_github-com_15d8f54f7d25f6a3",
      "fac_github-com_22464b8d707be589",
      "fac_github-com_3a125f613d377a78",
      "fac_github-com_5d4c5644b8271d97",
      "fac_github-com_6d09e85933ef2ffe",
      "fac_github-com_d52bd86952bc0fa4",
      "fac_github-com_fcb54eda2f2e983b",
      "fac_lumi-supercomputer-github-io_2898b5a62253ff54",
      "fac_lumi-supercomputer-github-io_2bc76536db33540e",
      "fac_lumi-supercomputer-github-io_cf0c35ecea86834e",
      "fac_raw-githubusercontent-com_9c20c2ace2a3f03d",
      "fac_wiki-irei-is_7bbe93833d3b3e7d",
      "fac_www-c3se-chalmers-se_82aed2dbdaaceb22",
      "fac_www-idris-fr_8305d415765a7ace",
      "fac_www-nsc-liu-se_74faec918fa90b73"
