{
  "run_dir": "runs/ai_factory_all_v2/shard_060",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_060/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_060/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_060/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_462000265-lumidata-eu_c831e3f31e56a0f5",
      "fac_cesga-docs-gitlab-io_6275dda9f688f87b",
      "fac_doc-slaif-si_936f2e8204a7322f",
      "fac_doc-slaif-si_e445507ab34af288",
      "fac_docs-archer2-ac-uk_2f9295e6394131be",
      "fac_docs-cscs-ch_845eabeb83b6c0e2",
      "fac_docs-lxp-lu_2f4b9296bff53f23",
      "fac_docs-vscentrum-be_41a191387661106e",
      "fac_doku-lrz-de_4443806b52692f4b",
      "fac_doku-lrz-de_a979090c2cc202ec",
      "fac_github-com_1ac76808ddcc8794",
      "fac_github-com_3f80259b6818ec06",
      "fac_github-com_42640db503a540f5",
      "fac_github-com_8a92d0b187afb2b0",
      "fac_github-com_ba1cac19b07d27cf",
      "fac_github-com_e01031d407be1ec1",
      "fac_guide-plgrid-pl_9a1dcf69d2e3a3b4",
      "fac_raw-githubusercontent-com_03fdf7474a68b53e",
      "fac_raw-githubusercontent-com_67b3e85b0263ffc9",
      "fac_raw-githubusercontent-com_67d0df7aecf2244c",
      "fac_vegadocs-vega-izum-si_048b62ef30e21c69",
      "fac_vegadocs-vega-izum-si_0fb2b1693b7dc82b",
      "fac_www-nsc-liu-se_931aa1ce718624e4"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_060/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
