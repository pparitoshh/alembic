{
  "run_dir": "runs/ai_factory_all_v2/shard_026",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_026/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_026/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_026/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_cesga-docs-gitlab-io_e138bc4452bcd544",
      "fac_docs-csc-fi_fd54e93eaed6a213",
      "fac_docs-hpc-gwdg-de_ea3df5031970628a",
      "fac_docs-lumi-supercomputer-eu_fd19728f6f07b28c",
      "fac_docs-lxp-lu_a2bf7b075a196406",
      "fac_docs-lxp-lu_fb856deff2044d1b",
      "fac_github-com_226eeaffc161f183",
      "fac_github-com_2524980a87ca0e0f",
      "fac_github-com_36d1416a8b2d69fe",
      "fac_github-com_3a3d6e0200c62d80",
      "fac_github-com_61d23bea25570ed0",
      "fac_github-com_6d566b3f20f66072",
      "fac_github-com_70ecef3e56a4b1a9",
      "fac_github-com_bcb2974aaccab0ec",
      "fac_github-com_c255f49c7811bbf2",
      "fac_indico-acnca-pt_acc64319aa705cde",
      "fac_lumi-supercomputer-github-io_41cb94a533b17e12",
      "fac_lumi-supercomputer-github-io_7acbcf4ee0538188",
      "fac_lumi-supercomputer-github-io_dd3aa63d6407bb63",
      "fac_lumi-supercomputer-github-io_edace37a4fcfdbb7",
      "fac_raw-githubusercontent-com_9c62eb5e3818941d",
      "fac_wiki-irei-is_7cea3dcdea5924be",
      "fac_www-nsc-liu-se_e4c75c02a471a288"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_026/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
