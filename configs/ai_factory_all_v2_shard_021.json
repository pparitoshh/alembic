{
  "run_dir": "runs/ai_factory_all_v2/shard_021",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_021/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_021/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_021/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_cesga-docs-gitlab-io_2f05e43d1fd03d5d",
      "fac_dci-dci-gitlab-cines-fr_5077a24fb6cb4e66",
      "fac_docs-csc-fi_3b2135b4b452a9f1",
      "fac_docs-discoverer-bg_68013888f253180e",
      "fac_docs-hpc-cineca-it_d95428e48df2a709",
      "fac_docs-hpc-gwdg-de_db241eceec976eee",
      "fac_docs-it4i-cz_e7343049af420333",
      "fac_docs-lxp-lu_b7d4f491d7670541",
      "fac_github-com_0ae69306fc4be398",
      "fac_github-com_1e76ffbd39c80b56",
      "fac_github-com_2df150ee8ba773c9",
      "fac_github-com_31a3126095869aab",
      "fac_github-com_5192fb57e4519a22",
      "fac_github-com_51f70c46930396df",
      "fac_github-com_708cf599676da1dd",
      "fac_github-com_8b75a940bae1bf52",
      "fac_github-com_9849e8922d74dae1",
      "fac_github-com_bdeb91dcc4833679",
      "fac_github-com_d275f6bbccb6d3d4",
      "fac_github-com_e31632b0e7e86316",
      "fac_gitlab-acnca-pt_793a8a9f2a9fbf75",
      "fac_raw-githubusercontent-com_867a9a0ec6fc2f9d",
      "fac_vegadocs-vega-izum-si_5ec0d5b73d2f7ca3",
      "fac_www-idris-fr_4da3a05930f86828",
      "fac_www-nsc-liu-se_a18fe6881037f0c6"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_021/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
