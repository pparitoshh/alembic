{
  "run_dir": "runs/ai_factory_all_v2/shard_009",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_009/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_009/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_009/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_dci-dci-gitlab-cines-fr_26094e4dfc112406",
      "fac_dci-dci-gitlab-cines-fr_32e00a5089fd3421",
      "fac_docs-archer2-ac-uk_68bc55176169b120",
      "fac_docs-csc-fi_65f9e3373ef2c7c3",
      "fac_docs-discoverer-bg_e3f4e8c04d80714b",
      "fac_doku-lrz-de_7211d94eea9f79bd",
      "fac_github-com_06cde72ab0e7fcbc",
      "fac_github-com_77024c0c4a797379",
      "fac_github-com_7a742c2467c9af6b",
      "fac_github-com_d3d16a3dc954c91b",
      "fac_github-com_efe42ba4e446dfaf",
      "fac_github-com_f0af00cf901781ef",
      "fac_lumi-supercomputer-github-io_517ff649358f3253",
      "fac_raw-githubusercontent-com_119a6c8192c96320",
      "fac_vegadocs-vega-izum-si_31fdb570e81617d1",
      "fac_www-bsc-es_1bc5ee0699fa4315",
      "fac_www-bsc-es_52b6e455a9899400",
      "fac_www-nsc-liu-se_4dabd0751c8c967d"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_009/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
