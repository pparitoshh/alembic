{
  "run_dir": "runs/ai_factory_all_v2/shard_024",
  "seeds": {
    "dir": "runs/ai_factory_all_v2/shard_024/seeds",
    "eval_docs": [
      "slurm_job_arrays",
      "slurm_requeue_signals"
    ],
    "chunk_chars": 2200,
    "registry": "runs/ai_factory_all_v2/shard_024/source_registry.json"
  },
  "teacher": {
    "base_url": "http://localhost:8000/v1",
    "model": "Qwen/Qwen3-32B-AWQ",
    "temperature": 0.5,
    "max_tokens": 2048,
    "concurrency": 48,
    "top_logprobs": 20,
    "extra_body": {
      "return_tokens_as_token_ids": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "judge": {
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "google/gemma-4-26B-A4B-it",
    "temperature": 0.0,
    "max_tokens": 8192,
    "concurrency": 32,
    "extra_body": {
      "repetition_penalty": 1.05
    }
  },
  "generate": {
    "questions_per_chunk": 1,
    "answers_per_question": 1,
    "personas": [
      "a new PhD student who has never used a cluster",
      "a research software engineer porting code to GPUs",
      "an ML engineer running multi-GPU training jobs",
      "a sysadmin debugging stuck or failing jobs"
    ],
    "task_types": [
      "concept",
      "howto",
      "script",
      "debug"
    ],
    "tool_fraction": 0.3,
    "tool_mix": {
      "call": 0.4,
      "ask": 0.2,
      "none": 0.4
    },
    "gold_dir": null,
    "scenario_plan": "runs/ai_factory_all_v2/shard_024/scenario_plan.json",
    "job_status_discovery": "clarify_first",
    "job_status_policy_version": "job-status-policy-v4",
    "tool_doc_ids": [
      "fac_cesga-docs-gitlab-io_b4dc641822a90fef",
      "fac_docs-csc-fi_59fc26340cf923e9",
      "fac_docs-csc-fi_982b7b735a96b817",
      "fac_docs-csc-fi_d4cd82fb43a85901",
      "fac_docs-hpc-cineca-it_97d9665d644c1679",
      "fac_docs-it4i-cz_210fbcd5dab8930d",
      "fac_docs-lumi-supercomputer-eu_0140bc4a7da5386a",
      "fac_docs-lxp-lu_f35bd247acc6c340",
      "fac_doku-lrz-de_8e16dd126ac41784",
      "fac_github-com_0c5fdf3790de6239",
      "fac_github-com_220bcc3cadf2c728",
      "fac_github-com_71d0ab90848a5edf",
      "fac_github-com_a5b5a862dd74d243",
      "fac_github-com_b4ecc8281a6330b5",
      "fac_github-com_d26c17e22ca26678",
      "fac_github-com_d2dc83e5db7bf2e3",
      "fac_github-com_f4a183884eda2420",
      "fac_github-com_fb91f52c0485d2df",
      "fac_lumi-supercomputer-github-io_152626ad34a54a1f",
      "fac_lumi-supercomputer-github-io_763289b7965fb243",
      "fac_raw-githubusercontent-com_c4305402b02d7973",
      "fac_www-bsc-es_952b120291ab857a",
      "fac_www-idris-fr_3787e025f866ab71",
      "fac_www-idris-fr_7393ce0774db8880"
    ]
  },
  "verify": {
    "dedup_threshold": 0.8,
    "max_answer_chars": 7000,
    "require_grounding_review": true,
    "grounding_review_protocol": "source-support-v3",
    "grounding_reviews": "runs/ai_factory_all_v2/shard_024/grounding_reviews.jsonl"
  },
  "student": {
    "model": "Qwen/Qwen3-4B-Instruct-2507",
    "system_prompt": "You are an HPC assistant. Use supplied source excerpts for site-specific facts and tool results for live state. Name the applicable cluster and ask for missing required details. Give a complete, clear answer without inventing commands, flags or cluster defaults. Put scripts in fenced code blocks."
  },
  "train": {
    "method": "lora",
    "load_in_4bit": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-05,
    "epochs": 1,
    "seed": 42,
    "batch_size": 2,
    "grad_accum": 8,
    "max_length": 4096,
    "bf16": true,
    "save_steps": 500,
    "val_fraction": 0.0,
    "report_to": []
  },
  "eval": {
    "file": "data/eval/eval_v3.jsonl",
    "tool_file": "data/eval/dev_v3/tools.jsonl",
    "calibration_file": "data/eval/judge_calibration.jsonl",
    "max_new_tokens": 768,
    "tool_protocol": "tool-first-response-v2",
    "tool_application_policy": "hpc-tools-clarify-first-v1"
  },
  "export": {
    "llama_cpp": "~/tools/llama.cpp",
    "quants": [
      "Q4_K_M",
      "Q8_0",
      "Q5_K_M",
      "Q3_K_M"
    ],
    "ollama_name": "hpc-assistant"
  }
}
